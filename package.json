{
  "name": "instawords",
  "version": "1.1.0",
  "description": "InstaWords — free, open-source amount-in-words (tafqit) for cheques and invoices: Arabic, English and French. Zero dependencies, browser + Node, offline Windows app and Excel VBA module.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./csv": {
      "types": "./dist/csv.d.ts",
      "default": "./dist/csv.js"
    },
    "./units.json": "./data/units.json"
  },
  "files": [
    "dist",
    "data",
    "vba",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "gen": "node scripts/gen-units.mjs",
    "build": "npm run gen && tsc -p tsconfig.build.json",
    "typecheck": "npm run gen && tsc -p tsconfig.json --noEmit",
    "test": "npm run gen && node --test \"tests/**/*.test.ts\"",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "test:site": "npm run build:site && node tests/site/smoke.mjs",
    "build:vba": "node scripts/build-vba.mjs",
    "test:vba": "npm run build && npm run build:vba && node --test \"tests/vba/**/*.test.mjs\"",
    "test:all": "npm test && npm run test:vba && npm run test:site",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "keywords": [
    "arabic",
    "tafqit",
    "تفقيط",
    "number-to-words",
    "cheque",
    "invoice"
  ],
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "^22.20.5",
    "typescript": "5.9.3"
  }
}
