<UserControl x:Class="InstaWords.App.Views.BulkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:InstaWords.App.Views"
             Focusable="False" IsTabStop="False" AllowDrop="True">
  <Grid Margin="24,20,24,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ContentControl Style="{StaticResource Card}" Padding="22,18">
      <StackPanel>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PrintRowsButton" Style="{StaticResource GhostButton}" ui:Ui.Icon="{StaticResource IconPrint}" Content="{DynamicResource Bulk.Print}" IsEnabled="False"
                    Click="OnPrintClick" Margin="0,0,8,0" ToolTip="{DynamicResource Bulk.PrintTip}"
                    AutomationProperties.AutomationId="BulkPrintButton" AutomationProperties.Name="{DynamicResource Bulk.Print}" />
            <Button x:Name="CopyAllButton" Style="{StaticResource GhostButton}" ui:Ui.Icon="{StaticResource IconCopy}" Content="{DynamicResource Bulk.CopyAll}" IsEnabled="False"
                    Click="OnCopyAllClick" Margin="0,0,8,0" ToolTip="{DynamicResource Bulk.CopyAllTip}"
                    AutomationProperties.AutomationId="CopyAllButton" AutomationProperties.Name="{DynamicResource Bulk.CopyAll}" />
            <Button x:Name="ExportButton" Style="{StaticResource PrimaryButton}" ui:Ui.Icon="{StaticResource IconDownload}" Content="{DynamicResource Bulk.Export}" IsEnabled="False"
                    Click="OnExportClick" AutomationProperties.AutomationId="ExportButton" AutomationProperties.Name="{DynamicResource Bulk.Export}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource H2Text}" FontSize="18" Text="{DynamicResource Bulk.Title}" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,3,0,0"
                       Text="{DynamicResource Bulk.Hint}" />
          </StackPanel>
        </DockPanel>

        <WrapPanel Margin="0,14,0,0">
          <Button Style="{StaticResource GhostButton}" ui:Ui.Icon="{StaticResource IconPaste}" ui:Ui.MirrorIcon="True" Content="{DynamicResource Bulk.Paste}" Click="OnPasteClick" Margin="0,0,8,8"
                  ToolTip="Ctrl+V" AutomationProperties.AutomationId="PasteButton" AutomationProperties.Name="{DynamicResource Bulk.Paste}" />
          <Button Style="{StaticResource GhostButton}" ui:Ui.Icon="{StaticResource IconUpload}" Content="{DynamicResource Bulk.Import}" Click="OnImportClick" Margin="0,0,8,8"
                  AutomationProperties.AutomationId="ImportButton" AutomationProperties.Name="{DynamicResource Bulk.ImportName}" />
          <Button Style="{StaticResource QuietButton}" ui:Ui.Icon="{StaticResource IconSparkle}" Content="{DynamicResource Bulk.Sample}" Click="OnSampleClick" Margin="0,0,4,8"
                  AutomationProperties.AutomationId="SampleButton" AutomationProperties.Name="{DynamicResource Bulk.Sample}" />
          <Button Style="{StaticResource QuietButton}" ui:Ui.Icon="{StaticResource IconTrash}" Content="{DynamicResource Common.Clear}" Click="OnClearClick" Margin="0,0,0,8"
                  AutomationProperties.AutomationId="ClearRowsButton" AutomationProperties.Name="{DynamicResource Bulk.ClearName}" />
        </WrapPanel>

        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="420" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="Auto" MinWidth="260" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Common.Unit}" />
            <ui:UnitPicker />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Common.OutputLanguage}" />
            <ui:LanguagePicker MinHeight="40" />
          </StackPanel>
        </Grid>
        <Expander Margin="0,10,0,0" AutomationProperties.AutomationId="BulkOptionsExpander" AutomationProperties.Name="{DynamicResource Options.Title}">
          <Expander.Header>
            <StackPanel Orientation="Horizontal">
              <ui:Icon Data="{StaticResource IconSettings}" Width="17" Height="17" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,9,0" />
              <TextBlock Text="{DynamicResource Options.Title}" FontWeight="Bold" FontSize="14.5" />
              <TextBlock Margin="12,0,0,0" FontSize="12.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                         Text="{DynamicResource Bulk.OptionsShared}" />
            </StackPanel>
          </Expander.Header>
          <ui:FormattingOptions Margin="0,6,0,4" />
        </Expander>
      </StackPanel>
    </ContentControl>

    <ContentControl Grid.Row="2" Style="{StaticResource Card}" Padding="0">
      <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,9" CornerRadius="0,0,14,14"
                Background="{StaticResource BgSofterBrush}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <TextBlock Style="{StaticResource HintText}" Text="{DynamicResource Bulk.CountAll}" />
              <TextBlock x:Name="CountAll" Margin="5,0,14,0" FontWeight="Bold" Text="0" AutomationProperties.AutomationId="CountAll" />
              <TextBlock Style="{StaticResource HintText}" Text="{DynamicResource Bulk.CountOk}" />
              <TextBlock x:Name="CountOk" Margin="5,0,14,0" FontWeight="Bold" Foreground="{StaticResource OkBrush}" Text="0" AutomationProperties.AutomationId="CountOk" />
              <TextBlock Style="{StaticResource HintText}" Text="{DynamicResource Bulk.CountErr}" />
              <TextBlock x:Name="CountErr" Margin="5,0,0,0" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Text="0" AutomationProperties.AutomationId="CountErr" />
            </StackPanel>
            <TextBlock x:Name="Status" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="BulkStatus" AutomationProperties.LiveSetting="Polite" />
          </DockPanel>
        </Border>
        <Grid>
          <DataGrid x:Name="Grid" Margin="8,8,8,0" BorderThickness="0" CanUserDeleteRows="True" Background="Transparent"
                    AutomationProperties.AutomationId="BulkGrid" AutomationProperties.Name="{DynamicResource Bulk.GridName}" SelectionChanged="OnGridSelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="64">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
                    <Setter Property="FontSize" Value="12.5" />
                    <Setter Property="FlowDirection" Value="LeftToRight" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn x:Name="ColInput" Binding="{Binding Input, UpdateSourceTrigger=LostFocus}" Width="150">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FlowDirection" Value="LeftToRight" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
                <DataGridTextColumn.EditingElementStyle>
                  <Style TargetType="TextBox">
                    <Setter Property="FlowDirection" Value="LeftToRight" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                    <Setter Property="FontSize" Value="14" />
                  </Style>
                </DataGridTextColumn.EditingElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn x:Name="ColCleaned" Binding="{Binding Cleaned}" IsReadOnly="True" Width="140">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FlowDirection" Value="LeftToRight" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn x:Name="ColText" Binding="{Binding Text}" IsReadOnly="True" Width="*" MinWidth="260">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FlowDirection" Value="{Binding TextFlow}" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="ToolTip" Value="{Binding Text}" />
                    <Setter Property="ToolTipService.IsEnabled" Value="{Binding Ok}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn x:Name="ColError" Binding="{Binding Error}" IsReadOnly="True" Width="230">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="ToolTip" Value="{Binding Error}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>

          <!-- Empty state (drop target hint) -->
          <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="0,40,0,0">
            <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource BrandSoftBrush}" HorizontalAlignment="Center">
              <ui:Icon Data="{StaticResource IconList}" FlowDirection="{DynamicResource UiFlow}" Width="26" Height="26" Foreground="{StaticResource BrandTextBrush}" />
            </Border>
            <TextBlock Margin="0,14,0,0" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Text="{DynamicResource Bulk.EmptyTitle}" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center" FontSize="13"
                       Text="{DynamicResource Bulk.EmptyHint}" />
          </StackPanel>
        </Grid>
      </DockPanel>
    </ContentControl>
  </Grid>
</UserControl>
