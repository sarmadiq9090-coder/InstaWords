<Window x:Class="InstaWords.App.Views.RatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:InstaWords.App.Views"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner"
        Title="{DynamicResource Rating.Title}" AutomationProperties.AutomationId="RatingWindow"
        Width="480" SizeToContent="Height" ResizeMode="NoResize">
  <!-- The one-time rating request of the Store copy (App.NoteCopied). No reward is offered for a rating (Store policy). -->
  <StackPanel Margin="20">
    <ContentControl Style="{StaticResource Card}">
      <DockPanel>
        <Image Source="{StaticResource LogoImage}" Width="52" Height="52" FlowDirection="LeftToRight" VerticalAlignment="Top" />
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource TitleText}" Text="{DynamicResource Rating.Title}" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="RatingHeadline" />
          <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="23" Text="{DynamicResource Rating.Body}" />
        </StackPanel>
      </DockPanel>
    </ContentControl>
    <DockPanel Margin="0,16,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" ui:Ui.Icon="{StaticResource IconStar}" Content="{DynamicResource Rating.Rate}"
              IsDefault="True" Click="OnRateClick" AutomationProperties.AutomationId="RatingRate" />
      <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="{DynamicResource Rating.NotNow}" Margin="8,0,0,0"
              IsCancel="True" Click="OnNotNowClick" AutomationProperties.AutomationId="RatingNotNow" />
    </DockPanel>
  </StackPanel>
</Window>
