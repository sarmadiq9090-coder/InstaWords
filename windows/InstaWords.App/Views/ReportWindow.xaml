<Window x:Class="InstaWords.App.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:InstaWords.App.Views"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner"
        Title="الإبلاغ عن مشكلة أو اقتراح" AutomationProperties.AutomationId="ReportWindow"
        Width="760" Height="720" MinWidth="620" MinHeight="560">
  <DockPanel Margin="20">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" ui:Ui.Icon="{StaticResource IconExternal}" Content="فتح في GitHub"
              Click="OnOpenGitHubClick" AutomationProperties.AutomationId="ReportOpenGitHub" />
      <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" ui:Ui.Icon="{StaticResource IconCopy}" Content="نسخ التقرير" Margin="8,0,0,0"
              Click="OnCopyClick" AutomationProperties.AutomationId="ReportCopy" />
      <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="إغلاق" IsCancel="True" Click="OnCloseClick"
              AutomationProperties.AutomationId="ReportClose" />
      <TextBlock x:Name="Status" DockPanel.Dock="Left" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                 Foreground="{StaticResource OkBrush}" TextWrapping="Wrap" MaxWidth="300" AutomationProperties.AutomationId="ReportStatus" />
    </DockPanel>

    <ContentControl Style="{StaticResource Card}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,0,-8,0" Padding="0,0,8,0">
        <StackPanel>
          <TextBlock Style="{StaticResource TitleText}" Text="الإبلاغ عن مشكلة أو اقتراح" />
          <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,16" FontSize="13"
                     Text="لا يُرسَل شيء تلقائياً: «فتح في GitHub» يفتح صفحة بلاغ جديد معبّأة في متصفحك لتراجعها وترسلها بنفسك، و«نسخ التقرير» ينسخ النص لتلصقه في بريد أو رسالة إن لم يكن لديك حساب GitHub." />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource LabelText}" Text="النوع" />
              <Border Style="{StaticResource SegmentShell}">
                <UniformGrid Rows="1">
                  <RadioButton x:Name="TypeBug" Style="{StaticResource SegmentRadio}" Content="مشكلة" IsChecked="True" Checked="OnChanged" MinWidth="90"
                               AutomationProperties.AutomationId="ReportTypeBug" />
                  <RadioButton x:Name="TypeIdea" Style="{StaticResource SegmentRadio}" Content="اقتراح" Checked="OnChanged" MinWidth="90"
                               AutomationProperties.AutomationId="ReportTypeIdea" />
                </UniformGrid>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource LabelText}" Text="العنوان" />
              <TextBox x:Name="TitleBox" TextChanged="OnChanged" ui:Ui.Placeholder="باختصار: ما الذي حدث أو ما الذي تقترحه؟" MaxLength="200"
                       AutomationProperties.AutomationId="ReportTitle" AutomationProperties.Name="العنوان" />
            </StackPanel>
          </Grid>

          <TextBlock x:Name="DescriptionLabel" Style="{StaticResource LabelText}" Text="الوصف" Margin="0,14,0,6" />
          <TextBox x:Name="DescriptionBox" TextChanged="OnChanged" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="200"
                   VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="8000"
                   AutomationProperties.AutomationId="ReportDescription" AutomationProperties.Name="الوصف" />

          <TextBlock x:Name="DetailsLabel" Style="{StaticResource LabelText}" Text="خطوات إعادة المشكلة (اختياري)" Margin="0,14,0,6" />
          <TextBox x:Name="DetailsBox" TextChanged="OnChanged" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="160"
                   VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="8000"
                   AutomationProperties.AutomationId="ReportDetails" AutomationProperties.Name="تفاصيل إضافية" />

          <CheckBox x:Name="IncludeTech" Margin="0,16,0,0" IsChecked="True" Click="OnChanged" AutomationProperties.AutomationId="ReportIncludeTech">
            <StackPanel>
              <TextBlock Text="إرفاق معلومات تقنية" />
              <TextBlock Style="{StaticResource HintText}"
                         Text="إصدار البرنامج وWindows و.NET، ولغة الواجهة، وخيارات التحويل، وآخر رمز خطأ. لا تُرفق أي أرقام أو محتوى الحافظة أو السجل." />
            </StackPanel>
          </CheckBox>

          <TextBlock Style="{StaticResource LabelText}" Text="معاينة ما سيُرسل" Margin="0,16,0,6" />
          <Border CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource BgSofterBrush}" Padding="12,10">
            <TextBox x:Name="Preview" Style="{StaticResource SelectableText}" FontSize="12.5" MaxHeight="220"
                     AutomationProperties.AutomationId="ReportPreview" AutomationProperties.Name="معاينة التقرير" />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </ContentControl>
  </DockPanel>
</Window>
