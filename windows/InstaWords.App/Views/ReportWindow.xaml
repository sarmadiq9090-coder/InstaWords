<Window x:Class="InstaWords.App.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:InstaWords.App.Views"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner"
        Title="{DynamicResource Main.ReportTip}" AutomationProperties.AutomationId="ReportWindow"
        Width="760" Height="720" MinWidth="620" MinHeight="560">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <!-- First: reach FastKiwi without a GitHub account (email when SupportContact.Email is set, otherwise the support page). -->
      <DockPanel LastChildFill="False">
        <Button x:Name="PrimaryAction" DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" ui:Ui.Icon="{StaticResource IconMessage}" Content="{DynamicResource Report.ContactPage}"
                Click="OnPrimaryClick" AutomationProperties.AutomationId="ReportPrimary" />
        <Button x:Name="TelegramButton" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" ui:Ui.Icon="{StaticResource IconExternal}" Content="{DynamicResource Report.Telegram}" Margin="8,0,0,0"
                Visibility="Collapsed" Click="OnTelegramClick" AutomationProperties.AutomationId="ReportTelegram" />
        <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" ui:Ui.Icon="{StaticResource IconCopy}" Content="{DynamicResource Report.Copy}" Margin="8,0,0,0"
                Click="OnCopyClick" AutomationProperties.AutomationId="ReportCopy" />
        <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="{DynamicResource Common.Close}" IsCancel="True" Click="OnCloseClick"
                AutomationProperties.AutomationId="ReportClose" />
      </DockPanel>
      <!-- Secondary: GitHub, for people who have an account. -->
      <DockPanel Margin="0,8,0,0">
        <Button DockPanel.Dock="Left" Style="{StaticResource QuietButton}" ui:Ui.Icon="{StaticResource IconExternal}" Content="{DynamicResource Report.OpenGitHub}" VerticalAlignment="Top"
                Click="OnOpenGitHubClick" AutomationProperties.AutomationId="ReportOpenGitHub" />
        <TextBlock x:Name="Status" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource OkBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="ReportStatus" />
      </DockPanel>
    </StackPanel>

    <ContentControl Style="{StaticResource Card}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,0,-8,0" Padding="0,0,8,0">
        <StackPanel>
          <TextBlock Style="{StaticResource TitleText}" Text="{DynamicResource Main.ReportTip}" />
          <TextBlock x:Name="Hint" Style="{StaticResource HintText}" Margin="0,4,0,16" FontSize="13"
                     Text="{DynamicResource Report.HintPage}" AutomationProperties.AutomationId="ReportHint" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Report.Type}" />
              <Border Style="{StaticResource SegmentShell}">
                <UniformGrid Rows="1">
                  <RadioButton x:Name="TypeBug" Style="{StaticResource SegmentRadio}" Content="{DynamicResource Report.Bug}" IsChecked="True" Checked="OnChanged" MinWidth="90"
                               AutomationProperties.AutomationId="ReportTypeBug" />
                  <RadioButton x:Name="TypeIdea" Style="{StaticResource SegmentRadio}" Content="{DynamicResource Report.Idea}" Checked="OnChanged" MinWidth="90"
                               AutomationProperties.AutomationId="ReportTypeIdea" />
                </UniformGrid>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Report.TitleLabel}" />
              <TextBox x:Name="TitleBox" TextChanged="OnChanged" ui:Ui.Placeholder="{DynamicResource Report.TitlePlaceholder}" MaxLength="200"
                       AutomationProperties.AutomationId="ReportTitle" AutomationProperties.Name="{DynamicResource Report.TitleLabel}" />
            </StackPanel>
          </Grid>

          <TextBlock x:Name="DescriptionLabel" Style="{StaticResource LabelText}" Text="{DynamicResource Report.Description}" Margin="0,14,0,6" />
          <TextBox x:Name="DescriptionBox" TextChanged="OnChanged" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="200"
                   VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="8000"
                   AutomationProperties.AutomationId="ReportDescription" AutomationProperties.Name="{DynamicResource Report.Description}" />

          <TextBlock x:Name="DetailsLabel" Style="{StaticResource LabelText}" Text="{DynamicResource Report.Steps}" Margin="0,14,0,6" />
          <TextBox x:Name="DetailsBox" TextChanged="OnChanged" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="160"
                   VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="8000"
                   AutomationProperties.AutomationId="ReportDetails" AutomationProperties.Name="{DynamicResource Report.DetailsName}" />

          <CheckBox x:Name="IncludeTech" Margin="0,16,0,0" IsChecked="True" Click="OnChanged" AutomationProperties.AutomationId="ReportIncludeTech">
            <StackPanel>
              <TextBlock Text="{DynamicResource Report.IncludeTech}" />
              <TextBlock Style="{StaticResource HintText}"
                         Text="{DynamicResource Report.IncludeTechHint}" />
            </StackPanel>
          </CheckBox>

          <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Report.Preview}" Margin="0,16,0,6" />
          <Border CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource BgSofterBrush}" Padding="12,10">
            <TextBox x:Name="Preview" Style="{StaticResource SelectableText}" FontSize="12.5" MaxHeight="220"
                     AutomationProperties.AutomationId="ReportPreview" AutomationProperties.Name="{DynamicResource Report.PreviewName}" />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </ContentControl>
  </DockPanel>
</Window>
