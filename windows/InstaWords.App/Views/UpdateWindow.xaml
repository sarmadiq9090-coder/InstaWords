<Window x:Class="InstaWords.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:InstaWords.App.Views"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner"
        Title="{DynamicResource Update.WindowTitle}" AutomationProperties.AutomationId="UpdateWindow"
        Width="600" SizeToContent="Height" ResizeMode="NoResize">
  <StackPanel Margin="20">
    <ContentControl Style="{StaticResource Card}">
      <StackPanel>
        <DockPanel>
          <Image Source="{StaticResource LogoImage}" Width="52" Height="52" FlowDirection="LeftToRight" VerticalAlignment="Top" />
          <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="Headline" Style="{StaticResource TitleText}" AutomationProperties.AutomationId="UpdateHeadline" />
            <TextBlock x:Name="Subline" Style="{StaticResource HintText}" FontSize="13" Margin="0,3,0,0" />
          </StackPanel>
        </DockPanel>

        <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Update.WhatsNew}" Margin="0,18,0,6" />
        <Border CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource BgSofterBrush}" Padding="14,10">
          <TextBox x:Name="Notes" Style="{StaticResource SelectableText}" MaxHeight="240" FontSize="13.5"
                   AutomationProperties.AutomationId="UpdateNotes" AutomationProperties.Name="{DynamicResource Update.NotesName}" />
        </Border>

        <StackPanel x:Name="ProgressPanel" Margin="0,16,0,0" Visibility="Collapsed">
          <DockPanel Margin="0,0,0,6">
            <TextBlock x:Name="ProgressPercent" DockPanel.Dock="Right" FontWeight="Bold" Foreground="{StaticResource AccentTextBrush}" FlowDirection="LeftToRight" />
            <TextBlock x:Name="ProgressText" Text="{DynamicResource Update.Downloading}" FontWeight="SemiBold" />
          </DockPanel>
          <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" AutomationProperties.AutomationId="UpdateProgress" />
        </StackPanel>

        <Border x:Name="ErrorBox" Style="{StaticResource ErrorBox}" Margin="0,14,0,0" Visibility="Collapsed">
          <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontWeight="SemiBold"
                     AutomationProperties.AutomationId="UpdateError" />
        </Border>

        <TextBlock x:Name="PortableNote" Style="{StaticResource HintText}" Margin="0,14,0,0" Visibility="Collapsed"
                   Text="{DynamicResource Update.PortableNote}" />
        <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0" FontSize="12"
                   Text="{DynamicResource Update.VerifyNote}" />
      </StackPanel>
    </ContentControl>

    <DockPanel Margin="0,16,0,0" LastChildFill="False">
      <Button x:Name="UpdateNow" DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" ui:Ui.Icon="{StaticResource IconDownload}" Content="{DynamicResource Update.Now}"
              Click="OnUpdateNowClick" AutomationProperties.AutomationId="UpdateNow" />
      <Button x:Name="Later" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="{DynamicResource Update.Later}" Margin="8,0,0,0" IsCancel="True"
              Click="OnLaterClick" AutomationProperties.AutomationId="UpdateLater" />
      <Button x:Name="SkipButton" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="{DynamicResource Update.Skip}"
              Click="OnSkipClick" AutomationProperties.AutomationId="UpdateSkip" />
    </DockPanel>
  </StackPanel>
</Window>
