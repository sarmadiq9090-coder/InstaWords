<UserControl x:Class="InstaWords.App.Views.MoreAppsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False" AutomationProperties.AutomationId="MoreApps">
  <!-- «المزيد من FastKiwi»: the other FastKiwi apps from the embedded Assets/apps.json (Services/MoreApps.cs). Links only; nothing is downloaded. -->
  <StackPanel>
    <TextBlock Style="{StaticResource H2Text}" Text="{DynamicResource More.Title}" Margin="0,0,0,6" />
    <TextBlock Style="{StaticResource HintText}" FontSize="13" Margin="0,0,0,6" Text="{DynamicResource More.Hint}" />
    <StackPanel x:Name="List" />
  </StackPanel>
</UserControl>
