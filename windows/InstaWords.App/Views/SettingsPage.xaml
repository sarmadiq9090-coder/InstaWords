<UserControl x:Class="InstaWords.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:InstaWords.App.Views"
             Focusable="False" IsTabStop="False">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="24,20,24,24" MaxWidth="900" HorizontalAlignment="Stretch">

      <!-- Conversion defaults -->
      <ContentControl Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource H2Text}" Text="خيارات التحويل الافتراضية" />
          <TextBlock Style="{StaticResource HintText}" Margin="0,3,0,16"
                     Text="تُستعمل في «تفقيط رقم» و«دفعة» واختصار الحافظة، وتُحفظ تلقائياً عند تغييرها." />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource LabelText}" Text="لغة التفقيط" />
              <ui:LanguagePicker MinHeight="40" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource LabelText}" Text="العملة أو الوحدة" />
              <ui:UnitPicker />
            </StackPanel>
          </Grid>
          <ui:FormattingOptions Margin="0,18,0,0" />
        </StackPanel>
      </ContentControl>

      <!-- Hotkey -->
      <ContentControl Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <DockPanel>
            <CheckBox x:Name="HotkeyEnabled" DockPanel.Dock="Right" VerticalAlignment="Center" Content="مفعّل" Click="OnHotkeyEnabledClick"
                      AutomationProperties.AutomationId="HotkeyEnabled" AutomationProperties.Name="تفعيل اختصار الحافظة" />
            <StackPanel Orientation="Horizontal">
              <ui:Icon Data="{StaticResource IconKeyboard}" Width="20" Height="20" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,9,0" />
              <TextBlock Style="{StaticResource H2Text}" Text="اختصار الحافظة" VerticalAlignment="Center" />
            </StackPanel>
          </DockPanel>
          <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,14" FontSize="13"
                     Text="انسخ رقماً من أي برنامج (Excel أو المتصفح أو برنامج المحاسبة)، ثم اضغط الاختصار: يصبح ما في الحافظة المبلغَ مكتوباً بالحروف، فالصقه حيث تشاء. يعمل والنافذة مغلقة ما دام InstaWords في شريط المهام." />
          <WrapPanel>
            <TextBox x:Name="HotkeyBox" Width="220" FontSize="16" FontWeight="SemiBold" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                     HorizontalContentAlignment="Center" FlowDirection="LeftToRight" Margin="0,0,10,8" Cursor="Hand"
                     ui:Ui.Placeholder="اضغط الاختصار الجديد…" ToolTip="انقر هنا ثم اضغط الاختصار الذي تريده، مثل Ctrl+Alt+T"
                     PreviewKeyDown="OnHotkeyKeyDown" GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur"
                     AutomationProperties.AutomationId="HotkeyBox" AutomationProperties.Name="الاختصار" />
            <Button x:Name="SaveHotkeyButton" Style="{StaticResource PrimaryButton}" Content="حفظ الاختصار" Click="OnSaveHotkeyClick" Margin="0,0,8,8"
                    IsEnabled="False" AutomationProperties.AutomationId="SaveHotkey" AutomationProperties.Name="حفظ الاختصار" />
            <Button Style="{StaticResource GhostButton}" Content="الافتراضي (Ctrl+Alt+T)" Click="OnDefaultHotkeyClick" Margin="0,0,8,8"
                    AutomationProperties.AutomationId="DefaultHotkey" AutomationProperties.Name="الاختصار الافتراضي" />
            <Button Style="{StaticResource QuietButton}" ui:Ui.Icon="{StaticResource IconPaste}" Content="جرّب الآن على الحافظة" Click="OnTryClick" Margin="0,0,0,8"
                    AutomationProperties.AutomationId="TryHotkey" AutomationProperties.Name="تحويل الحافظة الآن" />
          </WrapPanel>
          <Border x:Name="HotkeyStatusBox" CornerRadius="10" Padding="12,8" Margin="0,4,0,0" Background="{StaticResource BrandSofterBrush}">
            <DockPanel>
              <ui:Icon x:Name="HotkeyStatusIcon" Data="{StaticResource IconCheck}" Foreground="{StaticResource OkBrush}" Width="18" Height="18" Margin="0,1,9,0" VerticalAlignment="Top" />
              <TextBlock x:Name="HotkeyStatus" TextWrapping="Wrap" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource OkBrush}"
                         AutomationProperties.AutomationId="HotkeyStatus" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
          </Border>
          <CheckBox x:Name="ShowToast" Margin="0,16,0,0" Content="إظهار إشعار صغير بالنتيجة بعد التحويل" Click="OnShowToastClick"
                    AutomationProperties.AutomationId="ShowToast" />
        </StackPanel>
      </ContentControl>

      <!-- Startup and window -->
      <ContentControl Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource H2Text}" Text="التشغيل والنافذة" Margin="0,0,0,14" />
          <CheckBox x:Name="StartWithWindows" Click="OnStartWithWindowsClick" AutomationProperties.AutomationId="StartWithWindows">
            <StackPanel>
              <TextBlock Text="تشغيل مع Windows" />
              <TextBlock Style="{StaticResource HintText}" Text="يبدأ في شريط المهام دون فتح النافذة، ليعمل الاختصار من أول لحظة." />
            </StackPanel>
          </CheckBox>
          <CheckBox x:Name="CloseToTray" Margin="0,14,0,0" Click="OnTrayClick" AutomationProperties.AutomationId="CloseToTray">
            <StackPanel>
              <TextBlock Text="زر الإغلاق يُبقي البرنامج في شريط المهام" />
              <TextBlock Style="{StaticResource HintText}" Text="للخروج نهائياً: انقر أيقونته بجانب الساعة بالزر الأيمن ثم «خروج»." />
            </StackPanel>
          </CheckBox>
          <CheckBox x:Name="MinimizeToTray" Margin="0,14,0,0" Content="التصغير إلى شريط المهام بدل شريط البرامج" Click="OnTrayClick"
                    AutomationProperties.AutomationId="MinimizeToTray" />
          <CheckBox x:Name="AutoUpdate" Margin="0,14,0,0" Click="OnAutoUpdateClick" AutomationProperties.AutomationId="AutoUpdate">
            <StackPanel>
              <TextBlock Text="التحقق من التحديثات تلقائياً" />
              <TextBlock Style="{StaticResource HintText}" Text="مرة يومياً على الأكثر، من صفحة الإصدارات في GitHub. لا يُرسل أي رقم أو بيانات." />
            </StackPanel>
          </CheckBox>
          <WrapPanel Margin="0,14,0,0">
            <Button Style="{StaticResource GhostButton}" ui:Ui.Icon="{StaticResource IconRefresh}" Content="التحقق من وجود تحديث" Click="OnCheckUpdateClick"
                    Margin="0,0,10,0" AutomationProperties.AutomationId="CheckUpdate" AutomationProperties.Name="التحقق من وجود تحديث" />
            <TextBlock x:Name="UpdateStatus" Style="{StaticResource HintText}" VerticalAlignment="Center" AutomationProperties.AutomationId="UpdateStatus" />
          </WrapPanel>
        </StackPanel>
      </ContentControl>

      <!-- Data -->
      <ContentControl Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource H2Text}" Text="البيانات" Margin="0,0,0,8" />
          <TextBlock Style="{StaticResource HintText}" FontSize="13"
                     Text="الإعدادات والسجل محفوظة على جهازك فقط، في ملفين JSON. لا يتصل البرنامج بالإنترنت إلا للتحقق من التحديثات إن سمحت بذلك." />
          <TextBlock x:Name="DataPath" Margin="0,8,0,10" FontFamily="{StaticResource MonoFont}" FontSize="12.5" FlowDirection="LeftToRight"
                     HorizontalAlignment="Left" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
          <WrapPanel>
            <Button Style="{StaticResource GhostButton}" ui:Ui.Icon="{StaticResource IconFile}" Content="فتح المجلد" Click="OnOpenFolderClick" Margin="0,0,8,0" />
            <Button Style="{StaticResource GhostButton}" ui:Ui.Icon="{StaticResource IconTrash}" Content="مسح السجل" Click="OnClearHistoryClick" />
          </WrapPanel>
        </StackPanel>
      </ContentControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
