<Window x:Class="InstaWords.App.Views.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:InstaWords.App.Views"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner"
        Title="{DynamicResource Print.WindowTitle}" AutomationProperties.AutomationId="PrintWindow"
        Width="1180" Height="820" MinWidth="940" MinHeight="600" ResizeMode="CanResizeWithGrip">
  <DockPanel Margin="20">
    <!-- Actions -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="True">
      <Button x:Name="PrintNow" DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" ui:Ui.Icon="{StaticResource IconPrint}" Content="{DynamicResource Print.PrintNow}"
              MinWidth="130" Click="OnPrintClick" ToolTip="{DynamicResource Print.PdfHint}"
              AutomationProperties.AutomationId="PrintNow" AutomationProperties.Name="{DynamicResource Print.PrintNow}" />
      <Button x:Name="TestPrint" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" ui:Ui.Icon="{StaticResource IconGrid}" Content="{DynamicResource Print.TestPrint}"
              Margin="8,0,0,0" Click="OnTestPrintClick" ToolTip="{DynamicResource Print.TestPrintTip}"
              AutomationProperties.AutomationId="PrintTest" AutomationProperties.Name="{DynamicResource Print.TestPrint}" />
      <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="{DynamicResource Common.Close}" IsCancel="True" Click="OnCloseClick" MinWidth="90"
              AutomationProperties.AutomationId="PrintClose" />
      <StackPanel Margin="14,0,10,0" VerticalAlignment="Center">
        <TextBlock x:Name="Status" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource OkBrush}" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="PrintStatus" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Style="{StaticResource HintText}" FontSize="12" Text="{DynamicResource Print.PdfHint}" AutomationProperties.AutomationId="PrintPdfHint" />
      </StackPanel>
    </DockPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="430" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Fields -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,6,0" Margin="0,0,-6,0">
        <StackPanel>
          <ContentControl Style="{StaticResource Card}" Padding="18,16">
            <StackPanel>
              <TextBlock Style="{StaticResource H2Text}" Text="{DynamicResource Print.WhatToPrint}" Margin="0,0,0,10" />
              <Border Style="{StaticResource SegmentShell}" AutomationProperties.AutomationId="PrintTemplates">
                <UniformGrid Rows="1">
                  <RadioButton x:Name="TplCheque" Style="{StaticResource SegmentRadio}" Padding="6,5" Content="{DynamicResource Print.Template.Cheque}" Checked="OnTemplateChecked" Tag="Cheque"
                               AutomationProperties.AutomationId="PrintTemplateCheque" AutomationProperties.Name="{DynamicResource Print.Template.Cheque}" />
                  <RadioButton x:Name="TplReceipt" Style="{StaticResource SegmentRadio}" Padding="6,5" Content="{DynamicResource Print.Template.Receipt}" Checked="OnTemplateChecked" Tag="Receipt"
                               AutomationProperties.AutomationId="PrintTemplateReceipt" AutomationProperties.Name="{DynamicResource Print.Template.Receipt}" />
                  <RadioButton x:Name="TplPayment" Style="{StaticResource SegmentRadio}" Padding="6,5" Content="{DynamicResource Print.Template.Payment}" Checked="OnTemplateChecked" Tag="Payment"
                               AutomationProperties.AutomationId="PrintTemplatePayment" AutomationProperties.Name="{DynamicResource Print.Template.Payment}" />
                  <RadioButton x:Name="TplStrip" Style="{StaticResource SegmentRadio}" Padding="6,5" Content="{DynamicResource Print.Template.Strip}" Checked="OnTemplateChecked" Tag="Strip"
                               AutomationProperties.AutomationId="PrintTemplateStrip" AutomationProperties.Name="{DynamicResource Print.Template.Strip}" />
                </UniformGrid>
              </Border>
              <TextBlock x:Name="TemplateHint" Style="{StaticResource HintText}" Margin="2,8,0,0" AutomationProperties.AutomationId="PrintTemplateHint" />

              <!-- Amount: typed here, or the rows from the bulk tab -->
              <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Single.NumberLabel}" Margin="0,16,0,6" />
              <TextBox x:Name="AmountBox" FlowDirection="LeftToRight" FontSize="18" FontWeight="SemiBold" MaxLength="400" ui:Ui.Placeholder="0.00"
                       TextChanged="OnFieldChanged" AutomationProperties.AutomationId="PrintAmount" AutomationProperties.Name="{DynamicResource Single.NumberLabel}" />
              <Border x:Name="BulkInfo" Style="{StaticResource Pill}" Visibility="Collapsed" HorizontalAlignment="Left" Padding="12,6" Background="{StaticResource BrandSofterBrush}">
                <StackPanel Orientation="Horizontal">
                  <ui:Icon Data="{StaticResource IconList}" FlowDirection="{DynamicResource UiFlow}" Width="16" Height="16" Foreground="{StaticResource BrandTextBrush}" Margin="0,0,8,0" />
                  <TextBlock x:Name="BulkInfoText" FontWeight="SemiBold" Foreground="{StaticResource BrandTextBrush}" AutomationProperties.AutomationId="PrintBulkInfo" />
                </StackPanel>
              </Border>

              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Common.Unit}" />
                  <ui:UnitPicker />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Common.OutputLanguage}" />
                  <ui:LanguagePicker MinHeight="40" />
                </StackPanel>
              </Grid>

              <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Print.WordsLabel}" Margin="0,14,0,6" />
              <Border CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource BgSofterBrush}" Padding="12,8">
                <StackPanel>
                  <TextBox x:Name="WordsText" Style="{StaticResource SelectableText}" FontSize="14.5" FontWeight="SemiBold" MaxHeight="96"
                           AutomationProperties.AutomationId="PrintWords" AutomationProperties.Name="{DynamicResource Print.WordsLabel}" />
                  <TextBlock x:Name="WordsError" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"
                             AutomationProperties.AutomationId="PrintWordsError" />
                </StackPanel>
              </Border>
              <TextBlock Style="{StaticResource HintText}" Margin="2,6,0,0" Text="{DynamicResource Print.WordsHint}" />
            </StackPanel>
          </ContentControl>

          <!-- Details -->
          <ContentControl x:Name="DetailsCard" Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource H2Text}" Text="{DynamicResource Print.Details}" Margin="0,0,0,10" />
              <ui:VoucherHeaderEditor x:Name="HeaderEditor" Margin="0,0,0,12" />
              <Grid x:Name="NumberDateRow">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="NumberColumn" Width="*" />
                  <ColumnDefinition x:Name="NumberGap" Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="NumberPanel">
                  <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Print.NumberLabel}" />
                  <TextBox x:Name="NumberBox" FlowDirection="LeftToRight" MaxLength="40" TextChanged="OnFieldChanged"
                           AutomationProperties.AutomationId="PrintNumber" AutomationProperties.Name="{DynamicResource Print.NumberLabel}" />
                </StackPanel>
                <StackPanel x:Name="DatePanel" Grid.Column="2">
                  <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Print.Date}" />
                  <TextBox x:Name="DateBox" FlowDirection="LeftToRight" MaxLength="40" TextChanged="OnFieldChanged"
                           AutomationProperties.AutomationId="PrintDate" AutomationProperties.Name="{DynamicResource Print.Date}" />
                </StackPanel>
              </Grid>
              <TextBlock x:Name="PartyLabel" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
              <TextBox x:Name="PartyBox" MaxLength="160" TextChanged="OnFieldChanged" AutomationProperties.AutomationId="PrintParty" />
              <StackPanel x:Name="PurposePanel">
                <TextBlock x:Name="PurposeLabel" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                <TextBox x:Name="PurposeBox" MaxLength="240" TextChanged="OnFieldChanged" AutomationProperties.AutomationId="PrintPurpose" />
              </StackPanel>
              <CheckBox x:Name="SignatureBox" Margin="0,14,0,0" Content="{DynamicResource Print.ShowSignature}" Click="OnProfileOptionClick"
                        AutomationProperties.AutomationId="PrintSignature" />
            </StackPanel>
          </ContentControl>

          <!-- Paper and calibration -->
          <ContentControl Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,4">
            <StackPanel>
              <TextBlock Style="{StaticResource H2Text}" Text="{DynamicResource Print.PaperTitle}" Margin="0,0,0,10" />

              <StackPanel x:Name="ProfilePanel" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Print.Profile}" />
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" ui:Ui.Icon="{StaticResource IconTrash}" Click="OnDeleteProfile" Margin="4,0,0,0"
                          ToolTip="{DynamicResource Print.ProfileDelete}" AutomationProperties.Name="{DynamicResource Print.ProfileDelete}"
                          AutomationProperties.AutomationId="PrintProfileDelete" x:Name="DeleteProfileButton" />
                  <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" ui:Ui.Icon="{StaticResource IconPlus}" Content="{DynamicResource Print.ProfileNew}"
                          Click="OnNewProfile" Margin="8,0,0,0" AutomationProperties.AutomationId="PrintProfileNew" />
                  <ComboBox x:Name="ProfileCombo" SelectionChanged="OnProfileSelected" DisplayMemberPath="Name"
                            AutomationProperties.AutomationId="PrintProfile" AutomationProperties.Name="{DynamicResource Print.Profile}" />
                </DockPanel>
                <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Print.ProfileName}" Margin="0,10,0,6" />
                <TextBox x:Name="ProfileName" MaxLength="60" LostKeyboardFocus="OnProfileNameCommitted" KeyDown="OnProfileNameKeyDown"
                         AutomationProperties.AutomationId="PrintProfileName" AutomationProperties.Name="{DynamicResource Print.ProfileName}" />
              </StackPanel>

              <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Print.Paper}" />
              <ComboBox x:Name="PaperCombo" SelectionChanged="OnPaperSelected" AutomationProperties.AutomationId="PrintPaper"
                        AutomationProperties.Name="{DynamicResource Print.Paper}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <Grid x:Name="SizePanel" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Print.WidthMm}" />
                  <TextBox x:Name="WidthBox" FlowDirection="LeftToRight" LostKeyboardFocus="OnSizeCommitted" KeyDown="OnNumberKeyDown"
                           AutomationProperties.AutomationId="PrintPaperWidth" AutomationProperties.Name="{DynamicResource Print.WidthMm}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Print.HeightMm}" />
                  <TextBox x:Name="HeightBox" FlowDirection="LeftToRight" LostKeyboardFocus="OnSizeCommitted" KeyDown="OnNumberKeyDown"
                           AutomationProperties.AutomationId="PrintPaperHeight" AutomationProperties.Name="{DynamicResource Print.HeightMm}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Print.FontSize}" />
                  <TextBox x:Name="FontBox" FlowDirection="LeftToRight" LostKeyboardFocus="OnSizeCommitted" KeyDown="OnNumberKeyDown"
                           AutomationProperties.AutomationId="PrintFontSize" AutomationProperties.Name="{DynamicResource Print.FontSize}" />
                </StackPanel>
              </Grid>

              <StackPanel x:Name="CalibrationPanel">
                <CheckBox x:Name="FrameBox" Margin="0,14,0,0" Click="OnProfileOptionClick" AutomationProperties.AutomationId="PrintFrame">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Print.PrintFrame}" />
                    <TextBlock Style="{StaticResource HintText}" Text="{DynamicResource Print.PrintFrameHint}" />
                  </StackPanel>
                </CheckBox>
                <CheckBox x:Name="GridBox" Margin="0,12,0,0" Checked="OnGridClick" Unchecked="OnGridClick" AutomationProperties.AutomationId="PrintShowGrid">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Print.ShowGrid}" />
                    <TextBlock Style="{StaticResource HintText}" Text="{DynamicResource Print.ShowGridHint}" />
                  </StackPanel>
                </CheckBox>
                <Expander x:Name="OffsetsExpander" Margin="0,10,0,0" AutomationProperties.AutomationId="PrintOffsets"
                          AutomationProperties.Name="{DynamicResource Print.Offsets}">
                  <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                      <ui:Icon Data="{StaticResource IconSettings}" Width="17" Height="17" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,9,0" />
                      <TextBlock Text="{DynamicResource Print.Offsets}" FontWeight="Bold" FontSize="14.5" />
                    </StackPanel>
                  </Expander.Header>
                  <StackPanel>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8" Text="{DynamicResource Print.OffsetsHint}" />
                    <Grid x:Name="OffsetsGrid">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="92" />
                      </Grid.ColumnDefinitions>
                    </Grid>
                    <Button Style="{StaticResource QuietButton}" ui:Ui.Icon="{StaticResource IconRefresh}" Content="{DynamicResource Print.OffsetsReset}"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnResetOffsets" AutomationProperties.AutomationId="PrintOffsetsReset" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </StackPanel>
          </ContentControl>
        </StackPanel>
      </ScrollViewer>

      <!-- Live preview: the same visuals that are sent to the printer -->
      <ContentControl Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource QuietButton}" ui:Ui.Icon="{StaticResource IconMinus}" Click="OnZoomOut" Padding="8" MinHeight="0"
                        ToolTip="{DynamicResource Print.ZoomOut}" AutomationProperties.Name="{DynamicResource Print.ZoomOut}" AutomationProperties.AutomationId="PrintZoomOut" />
                <TextBlock x:Name="ZoomText" VerticalAlignment="Center" MinWidth="48" TextAlignment="Center" FontWeight="SemiBold" FlowDirection="LeftToRight"
                           Foreground="{StaticResource MutedBrush}" AutomationProperties.AutomationId="PrintZoom" />
                <Button Style="{StaticResource QuietButton}" ui:Ui.Icon="{StaticResource IconPlus}" Click="OnZoomIn" Padding="8" MinHeight="0"
                        ToolTip="{DynamicResource Print.ZoomIn}" AutomationProperties.Name="{DynamicResource Print.ZoomIn}" AutomationProperties.AutomationId="PrintZoomIn" />
                <Button Style="{StaticResource QuietButton}" ui:Ui.Icon="{StaticResource IconFit}" Click="OnZoomFit" Padding="8" MinHeight="0" Margin="4,0,0,0"
                        ToolTip="{DynamicResource Print.ZoomFit}" AutomationProperties.Name="{DynamicResource Print.ZoomFit}" AutomationProperties.AutomationId="PrintZoomFit" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource H2Text}" Text="{DynamicResource Print.Preview}" VerticalAlignment="Center" />
                <TextBlock x:Name="PageInfo" Style="{StaticResource HintText}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"
                           AutomationProperties.AutomationId="PrintPageInfo" />
              </StackPanel>
            </DockPanel>
          </Border>
          <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{StaticResource BgSoftBrush}"
                        Focusable="False" SizeChanged="OnPreviewSizeChanged" AutomationProperties.AutomationId="PrintPreview"
                        AutomationProperties.Name="{DynamicResource Print.Preview}">
            <!-- Pages are physical: never mirrored, whatever the interface direction. -->
            <StackPanel x:Name="Pages" FlowDirection="LeftToRight" Margin="24" HorizontalAlignment="Center" />
          </ScrollViewer>
        </DockPanel>
      </ContentControl>
    </Grid>
  </DockPanel>
</Window>
