<UserControl x:Class="InstaWords.App.Views.FormattingOptions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:InstaWords.App.Views"
             Focusable="False" IsTabStop="False">
  <!-- «خيارات الصياغة»: DataContext is the shared ConversionState. -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Column="0" Visibility="{Binding SupportsHundredsForm, Converter={StaticResource Visible}}">
      <TextBlock Style="{StaticResource LabelText}" Text="رسم المئة" />
      <Border Style="{StaticResource SegmentShell}" HorizontalAlignment="Stretch">
        <UniformGrid Rows="1">
          <RadioButton Style="{StaticResource SegmentRadio}"
                       IsChecked="{Binding HundredsForm, Converter={StaticResource Eq}, ConverterParameter=مائة}"
                       AutomationProperties.AutomationId="HundredsMiah" AutomationProperties.Name="مائة">
            <TextBlock><Run Text="مائة" /><Run Text=" ثلاثمائة" FontSize="12" FontWeight="Normal" Foreground="{StaticResource MutedBrush}" /></TextBlock>
          </RadioButton>
          <RadioButton Style="{StaticResource SegmentRadio}"
                       IsChecked="{Binding HundredsForm, Converter={StaticResource Eq}, ConverterParameter=مئة}"
                       AutomationProperties.AutomationId="HundredsMia" AutomationProperties.Name="مئة">
            <TextBlock><Run Text="مئة" /><Run Text=" ثلاثمئة" FontSize="12" FontWeight="Normal" Foreground="{StaticResource MutedBrush}" /></TextBlock>
          </RadioButton>
        </UniformGrid>
      </Border>
    </StackPanel>

    <StackPanel Grid.Column="2">
      <TextBlock Style="{StaticResource LabelText}" Text="الخانات العشرية الزائدة" />
      <Border Style="{StaticResource SegmentShell}">
        <UniformGrid Rows="1">
          <RadioButton Style="{StaticResource SegmentRadio}"
                       IsChecked="{Binding Decimals, Converter={StaticResource Eq}, ConverterParameter=round}"
                       AutomationProperties.AutomationId="DecimalsRound" AutomationProperties.Name="تقريب"
                       ToolTip="تقريب نصفي للأعلى إلى دقة العملة: 10.125 ريال تصبح 10.13">
            <TextBlock Text="تقريب" TextTrimming="CharacterEllipsis" />
          </RadioButton>
          <RadioButton Style="{StaticResource SegmentRadio}"
                       IsChecked="{Binding Decimals, Converter={StaticResource Eq}, ConverterParameter=error}"
                       AutomationProperties.AutomationId="DecimalsError" AutomationProperties.Name="إظهار خطأ"
                       ToolTip="لا تقريب: يظهر خطأ إذا زادت الخانات العشرية على دقة العملة، للتدقيق">
            <TextBlock Text="إظهار خطأ" TextTrimming="CharacterEllipsis" />
          </RadioButton>
        </UniformGrid>
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="2" Grid.Column="0">
      <TextBlock Style="{StaticResource LabelText}" Text="نص قبل المبلغ" />
      <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" FlowDirection="{Binding ResultFlow}" ui:Ui.Placeholder="مثل: فقط"
               AutomationProperties.AutomationId="PrefixInput" AutomationProperties.Name="نص قبل المبلغ" />
    </StackPanel>
    <StackPanel Grid.Row="2" Grid.Column="2">
      <TextBlock Style="{StaticResource LabelText}" Text="نص بعد المبلغ" />
      <TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" FlowDirection="{Binding ResultFlow}" ui:Ui.Placeholder="مثل: لا غير"
               AutomationProperties.AutomationId="SuffixInput" AutomationProperties.Name="نص بعد المبلغ" />
    </StackPanel>

    <WrapPanel Grid.Row="4" Grid.ColumnSpan="3" VerticalAlignment="Center">
      <TextBlock Style="{StaticResource HintText}" Text="صيغ جاهزة:" VerticalAlignment="Center" Margin="0,0,8,0" />
      <Button Style="{StaticResource ChipButton}" Content="{Binding PresetLabel}" Click="OnPresetClick" Margin="0,0,6,0" MaxWidth="420"
              AutomationProperties.AutomationId="PresetOnly" AutomationProperties.Name="صيغة جاهزة" />
      <Button Style="{StaticResource ChipButton}" Content="بلا إضافات" Click="OnNoneClick"
              AutomationProperties.AutomationId="PresetNone" AutomationProperties.Name="بلا إضافات" />
    </WrapPanel>
  </Grid>
</UserControl>
