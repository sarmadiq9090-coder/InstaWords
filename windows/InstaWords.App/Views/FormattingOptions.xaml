<UserControl x:Class="InstaWords.App.Views.FormattingOptions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:InstaWords.App.Views"
             Focusable="False" IsTabStop="False">
  <!-- «خيارات الصياغة»: DataContext is the shared ConversionState. -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Column="0" Visibility="{Binding SupportsHundredsForm, Converter={StaticResource Visible}}">
      <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Options.Hundreds}" />
      <Border Style="{StaticResource SegmentShell}" HorizontalAlignment="Stretch">
        <UniformGrid Rows="1">
          <RadioButton Style="{StaticResource SegmentRadio}"
                       IsChecked="{Binding HundredsForm, Converter={StaticResource Eq}, ConverterParameter=مائة}"
                       AutomationProperties.AutomationId="HundredsMiah" AutomationProperties.Name="مائة">
            <TextBlock><Run Text="مائة" /><Run Text=" ثلاثمائة" FontSize="12" FontWeight="Normal" Foreground="{StaticResource MutedBrush}" /></TextBlock>
          </RadioButton>
          <RadioButton Style="{StaticResource SegmentRadio}"
                       IsChecked="{Binding HundredsForm, Converter={StaticResource Eq}, ConverterParameter=مئة}"
                       AutomationProperties.AutomationId="HundredsMia" AutomationProperties.Name="مئة">
            <TextBlock><Run Text="مئة" /><Run Text=" ثلاثمئة" FontSize="12" FontWeight="Normal" Foreground="{StaticResource MutedBrush}" /></TextBlock>
          </RadioButton>
        </UniformGrid>
      </Border>
    </StackPanel>

    <!-- English and French have no «مائة / مئة» choice: the decimals choice then takes the first column
         instead of leaving it blank. -->
    <StackPanel>
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Grid.Column" Value="2" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding SupportsHundredsForm}" Value="False">
              <Setter Property="Grid.Column" Value="0" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>
      <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Options.Decimals}" />
      <Border Style="{StaticResource SegmentShell}">
        <UniformGrid Rows="1">
          <RadioButton Style="{StaticResource SegmentRadio}"
                       IsChecked="{Binding Decimals, Converter={StaticResource Eq}, ConverterParameter=round}"
                       AutomationProperties.AutomationId="DecimalsRound" AutomationProperties.Name="{DynamicResource Options.Round}"
                       ToolTip="{DynamicResource Options.RoundTip}">
            <TextBlock Text="{DynamicResource Options.Round}" TextTrimming="CharacterEllipsis" />
          </RadioButton>
          <RadioButton Style="{StaticResource SegmentRadio}"
                       IsChecked="{Binding Decimals, Converter={StaticResource Eq}, ConverterParameter=error}"
                       AutomationProperties.AutomationId="DecimalsError" AutomationProperties.Name="{DynamicResource Options.Error}"
                       ToolTip="{DynamicResource Options.ErrorTip}">
            <TextBlock Text="{DynamicResource Options.Error}" TextTrimming="CharacterEllipsis" />
          </RadioButton>
        </UniformGrid>
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="2" Grid.Column="0">
      <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Options.Prefix}" />
      <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" FlowDirection="{Binding ResultFlow}" ui:Ui.Placeholder="{DynamicResource Options.PrefixPlaceholder}"
               AutomationProperties.AutomationId="PrefixInput" AutomationProperties.Name="{DynamicResource Options.Prefix}" />
    </StackPanel>
    <StackPanel Grid.Row="2" Grid.Column="2">
      <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Options.Suffix}" />
      <TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" FlowDirection="{Binding ResultFlow}" ui:Ui.Placeholder="{DynamicResource Options.SuffixPlaceholder}"
               AutomationProperties.AutomationId="SuffixInput" AutomationProperties.Name="{DynamicResource Options.Suffix}" />
    </StackPanel>

    <WrapPanel Grid.Row="4" Grid.ColumnSpan="3" VerticalAlignment="Center">
      <TextBlock Style="{StaticResource HintText}" Text="{DynamicResource Options.Presets}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <Button Style="{StaticResource ChipButton}" Content="{Binding PresetLabel}" Click="OnPresetClick" Margin="0,0,6,0" MaxWidth="420"
              AutomationProperties.AutomationId="PresetOnly" AutomationProperties.Name="{DynamicResource Options.PresetName}" />
      <Button Style="{StaticResource ChipButton}" Content="{DynamicResource Options.NoAffix}" Click="OnNoneClick"
              AutomationProperties.AutomationId="PresetNone" AutomationProperties.Name="{DynamicResource Options.NoAffix}" />
    </WrapPanel>
  </Grid>
</UserControl>
