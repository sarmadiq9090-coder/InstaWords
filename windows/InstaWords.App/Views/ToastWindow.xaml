<Window x:Class="InstaWords.App.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:InstaWords.App.Views"
        Title="{DynamicResource Toast.WindowTitle}"
        AutomationProperties.AutomationId="Toast"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        SizeToContent="Height" Width="408"
        FlowDirection="{DynamicResource UiFlow}" FontFamily="{StaticResource AppFont}" FontSize="14"
        Foreground="{StaticResource TextBrush}" TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" Opacity="0">
  <Grid Margin="14,10,14,18" Cursor="Hand">
    <Border CornerRadius="14" Background="{StaticResource SurfaceBrush}" Effect="{StaticResource PopupShadow}" />
    <Border CornerRadius="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="5" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- Start-side accent bar: rounded on the outer corners (mirrors with the interface direction). -->
        <Border x:Name="Accent" Grid.Column="0" CornerRadius="14,0,0,14" Background="{StaticResource BrandGradientBrush}" />
        <Border x:Name="IconBadge" Grid.Column="1" Width="34" Height="34" CornerRadius="17" Margin="14,14,0,0" VerticalAlignment="Top"
                Background="{StaticResource BrandSoftBrush}">
          <ui:Icon x:Name="BadgeIcon" Data="{StaticResource IconCheck}" Width="18" Height="18" StrokeThickness="2.6" Foreground="{StaticResource BrandTextBrush}" />
        </Border>
        <StackPanel Grid.Column="2" Margin="12,12,6,14">
          <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" AutomationProperties.AutomationId="ToastTitle" />
          <TextBlock x:Name="BodyText" Margin="0,4,0,0" FontSize="15" LineHeight="24" TextWrapping="Wrap" MaxHeight="96" TextTrimming="WordEllipsis"
                     Foreground="{StaticResource TextBrush}" AutomationProperties.AutomationId="ToastBody" />
          <TextBlock x:Name="HintText" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="{DynamicResource Toast.Hint}" />
        </StackPanel>
        <Button Grid.Column="3" Style="{StaticResource QuietButton}" ui:Ui.Icon="{StaticResource IconClose}" VerticalAlignment="Top" Margin="0,8,8,0"
                Padding="6" MinHeight="0" Click="OnCloseClick" AutomationProperties.Name="{DynamicResource Toast.Close}" Focusable="False" />
      </Grid>
    </Border>
  </Grid>
</Window>
