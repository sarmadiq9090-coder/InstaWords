<UserControl x:Class="InstaWords.App.Views.VoucherHeaderEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:InstaWords.App.Views"
             Focusable="False" IsTabStop="False">
  <!-- Voucher header: optional company name and logo (saved in the settings; shown in Settings and in the print dialog). -->
  <!-- Company name and logo side by side; on a narrow width (ApplyLayout) the logo moves below the name. -->
  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition x:Name="GapColumn" Width="16" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel x:Name="CompanyPanel">
      <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Print.Company}" />
      <TextBox x:Name="CompanyBox" MaxLength="120" TextChanged="OnCompanyChanged" ui:Ui.Placeholder="{DynamicResource Print.CompanyPlaceholder}"
               AutomationProperties.AutomationId="PrintCompany" AutomationProperties.Name="{DynamicResource Print.Company}" />
    </StackPanel>
    <StackPanel x:Name="LogoPanel" Grid.Column="2">
      <TextBlock Style="{StaticResource LabelText}" Text="{DynamicResource Print.Logo}" />
      <StackPanel Orientation="Horizontal">
        <Border Width="40" Height="40" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource BgSofterBrush}"
                Margin="0,0,8,0">
          <Grid>
            <ui:Icon x:Name="LogoPlaceholder" Data="{StaticResource IconImage}" Width="18" Height="18" Foreground="{StaticResource SubtleBrush}" />
            <Image x:Name="LogoImage" Margin="3" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" FlowDirection="LeftToRight" />
          </Grid>
        </Border>
        <Button Style="{StaticResource GhostButton}" ui:Ui.Icon="{StaticResource IconUpload}" Content="{DynamicResource Print.LogoChoose}" Click="OnChooseLogo"
                AutomationProperties.AutomationId="PrintLogoChoose" Margin="0,0,6,0" />
        <Button x:Name="RemoveLogo" Style="{StaticResource QuietButton}" ui:Ui.Icon="{StaticResource IconTrash}" Click="OnRemoveLogo"
                ToolTip="{DynamicResource Print.LogoRemove}" AutomationProperties.Name="{DynamicResource Print.LogoRemove}"
                AutomationProperties.AutomationId="PrintLogoRemove" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
