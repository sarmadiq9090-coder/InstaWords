<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- FastKiwi design language (light theme), same tokens as site/assets/style.css. -->

  <FontFamily x:Key="AppFont">pack://application:,,,/Fonts/#IBM Plex Sans Arabic, Segoe UI, Tahoma</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

  <Color x:Key="BgColor">#FFFFFF</Color>
  <Color x:Key="BgSoftColor">#F5F9EF</Color>
  <Color x:Key="BgSofterColor">#FAFCF6</Color>
  <Color x:Key="SurfaceColor">#FFFFFF</Color>
  <Color x:Key="TextColor">#14200F</Color>
  <Color x:Key="MutedColor">#4A5A42</Color>
  <Color x:Key="SubtleColor">#6B7A63</Color>
  <Color x:Key="BorderColor">#E2EAD8</Color>
  <Color x:Key="BorderStrongColor">#C9D6BB</Color>
  <Color x:Key="BrandColor">#4C9A1E</Color>
  <Color x:Key="BrandDarkColor">#3A7D14</Color>
  <Color x:Key="Brand2Color">#0D9488</Color>
  <Color x:Key="Brand2DarkColor">#0F766E</Color>
  <Color x:Key="BrandTextColor">#2F6F10</Color>
  <Color x:Key="AccentTextColor">#0F766E</Color>
  <Color x:Key="BrandSoftColor">#EAF4DF</Color>
  <Color x:Key="BrandSofterColor">#F2F8EA</Color>
  <Color x:Key="DangerColor">#B42318</Color>
  <Color x:Key="DangerSoftColor">#FDECEA</Color>
  <Color x:Key="DangerBorderColor">#F5C2BC</Color>
  <Color x:Key="OkColor">#2F7D0F</Color>
  <Color x:Key="ShadowColor">#0F172A</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="BgSoftBrush" Color="{StaticResource BgSoftColor}" />
  <SolidColorBrush x:Key="BgSofterBrush" Color="{StaticResource BgSofterColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
  <SolidColorBrush x:Key="Brand2Brush" Color="{StaticResource Brand2Color}" />
  <SolidColorBrush x:Key="BrandTextBrush" Color="{StaticResource BrandTextColor}" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
  <SolidColorBrush x:Key="BrandSoftBrush" Color="{StaticResource BrandSoftColor}" />
  <SolidColorBrush x:Key="BrandSofterBrush" Color="{StaticResource BrandSofterColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
  <SolidColorBrush x:Key="DangerBorderBrush" Color="{StaticResource DangerBorderColor}" />
  <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
  <SolidColorBrush x:Key="FocusRingBrush" Color="#594C9A1E" />

  <!-- The brand gradient (135deg, #3a7d14 → #0f766e) and its hover / pressed shades. -->
  <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#3A7D14" />
    <GradientStop Offset="1" Color="#0F766E" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="BrandGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#336F11" />
    <GradientStop Offset="1" Color="#0C6760" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="BrandGradientPressedBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#2C610F" />
    <GradientStop Offset="1" Color="#0A5852" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="BrandGradientLightBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#4C9A1E" />
    <GradientStop Offset="1" Color="#0D9488" />
  </LinearGradientBrush>
  <!-- Result ("cheque") background: a whisper of the brand colours. -->
  <LinearGradientBrush x:Key="ChequeBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#F6FAF0" />
    <GradientStop Offset="1" Color="#EFF8F5" />
  </LinearGradientBrush>

  <DropShadowEffect x:Key="CardShadow" Color="{StaticResource ShadowColor}" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.07" />
  <DropShadowEffect x:Key="SoftShadow" Color="{StaticResource ShadowColor}" BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.10" />
  <DropShadowEffect x:Key="PopupShadow" Color="{StaticResource ShadowColor}" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.16" />
  <DropShadowEffect x:Key="ButtonShadow" Color="#3A7D14" BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.28" />

  <CornerRadius x:Key="RadiusCard">14</CornerRadius>
  <CornerRadius x:Key="RadiusControl">10</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <!-- Icons (24×24 line icons, stroked; the same set as the website). -->
  <Geometry x:Key="IconCopy">M10,8 H18 A2,2 0 0 1 20,10 V18 A2,2 0 0 1 18,20 H10 A2,2 0 0 1 8,18 V10 A2,2 0 0 1 10,8 Z M16,8 V6 A2,2 0 0 0 14,4 H6 A2,2 0 0 0 4,6 V14 A2,2 0 0 0 6,16 H8</Geometry>
  <Geometry x:Key="IconCheck">M20,6 L9,17 L4,12</Geometry>
  <Geometry x:Key="IconClose">M6,6 L18,18 M18,6 L6,18</Geometry>
  <Geometry x:Key="IconSearch">M11,4 A7,7 0 1 1 10.99,4 Z M20,20 L16,16</Geometry>
  <Geometry x:Key="IconChevronDown">M6,9 L12,15 L18,9</Geometry>
  <Geometry x:Key="IconHistory">M3,12 A9,9 0 1 0 6,5.3 M3,4 V9 H8 M12,7 V12 L15,14</Geometry>
  <Geometry x:Key="IconUpload">M12,15 V3 M7,8 L12,3 L17,8 M4,15 V19 A2,2 0 0 0 6,21 H18 A2,2 0 0 0 20,19 V15</Geometry>
  <Geometry x:Key="IconDownload">M12,3 V15 M7,10 L12,15 L17,10 M4,15 V19 A2,2 0 0 0 6,21 H18 A2,2 0 0 0 20,19 V15</Geometry>
  <Geometry x:Key="IconPaste">M9,4 H15 V7 H9 Z M15,5 H17 A2,2 0 0 1 19,7 V19 A2,2 0 0 1 17,21 H7 A2,2 0 0 1 5,19 V7 A2,2 0 0 1 7,5 H9 M9,12 H15 M9,16 H13</Geometry>
  <Geometry x:Key="IconTrash">M4,7 H20 M10,11 V17 M14,11 V17 M6,7 L7,19 A2,2 0 0 0 9,21 H15 A2,2 0 0 0 17,19 L18,7 M9,7 V4 H15 V7</Geometry>
  <Geometry x:Key="IconList">M8,6 H21 M8,12 H21 M8,18 H21 M3,6 H3.01 M3,12 H3.01 M3,18 H3.01</Geometry>
  <Geometry x:Key="IconHash">M4,9 H20 M4,15 H20 M10,3 L8,21 M16,3 L14,21</Geometry>
  <Geometry x:Key="IconSettings">M4,21 V14 M4,10 V3 M12,21 V12 M12,8 V3 M20,21 V16 M20,12 V3 M1,14 H7 M9,8 H15 M17,16 H23</Geometry>
  <Geometry x:Key="IconInfo">M12,3 A9,9 0 1 1 11.99,3 Z M12,16 V11 M12,8 H12.01</Geometry>
  <Geometry x:Key="IconKeyboard">M4,6 H20 A2,2 0 0 1 22,8 V16 A2,2 0 0 1 20,18 H4 A2,2 0 0 1 2,16 V8 A2,2 0 0 1 4,6 Z M6,10 H6.01 M10,10 H10.01 M14,10 H14.01 M18,10 H18.01 M8,14 H16</Geometry>
  <Geometry x:Key="IconAlert">M12,3 A9,9 0 1 1 11.99,3 Z M12,8 V12.5 M12,16 H12.01</Geometry>
  <Geometry x:Key="IconSparkle">M12,3 L13.8,9.2 L20,11 L13.8,12.8 L12,19 L10.2,12.8 L4,11 L10.2,9.2 Z</Geometry>
  <Geometry x:Key="IconExternal">M14,4 H20 V10 M20,4 L11,13 M18,14 V19 A1,1 0 0 1 17,20 H5 A1,1 0 0 1 4,19 V7 A1,1 0 0 1 5,6 H10</Geometry>
  <Geometry x:Key="IconMessage">M21,15 A2,2 0 0 1 19,17 H7 L3,21 V5 A2,2 0 0 1 5,3 H19 A2,2 0 0 1 21,5 Z M8,8 H16 M8,12 H13</Geometry>
  <Geometry x:Key="IconRefresh">M21,12 A9,9 0 1 1 18.4,5.6 M21,3 V9 H15</Geometry>
  <Geometry x:Key="IconFile">M14,3 H7 A2,2 0 0 0 5,5 V19 A2,2 0 0 0 7,21 H17 A2,2 0 0 0 19,19 V8 Z M14,3 V8 H19 M9,13 H15 M9,17 H13</Geometry>

  <!-- The InstaWords mark (site/icon.svg) as a vector drawing, crisp at any DPI. -->
  <DrawingImage x:Key="LogoImage">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{StaticResource BrandGradientBrush}">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,64,64" RadiusX="15" RadiusY="15" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Pen>
            <Pen Brush="#61FFFFFF" Thickness="1.5" DashCap="Flat">
              <Pen.DashStyle>
                <DashStyle Dashes="1.333,2" />
              </Pen.DashStyle>
            </Pen>
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="7,7,50,50" RadiusX="10" RadiusY="10" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M15,27 C15,36.5 21.6,41 32,41 C42.4,41 49,36.5 49,27">
          <GeometryDrawing.Pen>
            <Pen Brush="White" Thickness="5.5" StartLineCap="Round" EndLineCap="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="White">
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <EllipseGeometry Center="27.5,19.5" RadiusX="3.6" RadiusY="3.6" />
              <EllipseGeometry Center="37.5,19.5" RadiusX="3.6" RadiusY="3.6" />
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M17,50 L47,50">
          <GeometryDrawing.Pen>
            <Pen Brush="#D9F99D" Thickness="3" StartLineCap="Round" EndLineCap="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

</ResourceDictionary>
