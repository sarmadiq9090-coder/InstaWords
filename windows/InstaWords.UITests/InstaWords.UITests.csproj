<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end UI tests (FlaUI + UI Automation) of the built InstaWords.exe. Windows only: they need an
    interactive desktop (GitHub's windows-latest runners have one). Screenshots go to INSTAWORDS_ARTIFACTS
    (default: screenshots/ next to the test binaries). The app path can be set with INSTAWORDS_APP_PATH.
    Build the app first:  dotnet build windows/InstaWords.App -c Release
    Then:                 dotnet test windows/InstaWords.UITests -c Release
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>disable</Nullable>
    <RootNamespace>InstaWords.UITests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
    <PackageReference Include="FlaUI.Core" Version="5.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expected texts come from the same engine the app uses. -->
    <ProjectReference Include="..\InstaWords.Core\InstaWords.Core.csproj" />
  </ItemGroup>

</Project>
