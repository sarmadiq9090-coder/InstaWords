<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the WPF app's pure logic (no UI, runs on any OS): update checks (version compare,
    asset selection, download URL allow-list, SHA-256 digest), problem-report links (GitHub issue, mailto:), CSV import/export,
    interface strings (Strings.ar.xaml / Strings.en.xaml: same keys, every key the app uses), Store mode
    (package detection, install kind, MSIX data folder, startup task states), the crash log (format, size cap),
    the print layout math (mm/DIP, cheque calibration offsets, word wrap and filler, template fields), and
    the amount shown with the words (money with its subunit decimals, rounded like the words).
    The source files are linked from InstaWords.App, which itself targets net48.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>disable</Nullable>
    <RootNamespace>InstaWords.App.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InstaWords.Core\InstaWords.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\InstaWords.App\Services\UpdateLogic.cs" Link="Linked\UpdateLogic.cs" />
    <Compile Include="..\InstaWords.App\Services\ReportBuilder.cs" Link="Linked\ReportBuilder.cs" />
    <Compile Include="..\InstaWords.App\Services\Csv.cs" Link="Linked\Csv.cs" />
    <Compile Include="..\InstaWords.App\Services\Loc.cs" Link="Linked\Loc.cs" />
    <Compile Include="..\InstaWords.App\Services\PrintLayout.cs" Link="Linked\PrintLayout.cs" />
    <Compile Include="..\InstaWords.App\Services\CrashLog.cs" Link="Linked\CrashLog.cs" />
    <Compile Include="..\InstaWords.App\Services\StoreLogic.cs" Link="Linked\StoreLogic.cs" />
    <Compile Include="..\InstaWords.App\Services\AmountFormat.cs" Link="Linked\AmountFormat.cs" />
    <Compile Include="..\InstaWords.App\Services\Conversion.cs" Link="Linked\Conversion.cs" />
    <Compile Include="..\InstaWords.App\Services\SupportContact.cs" Link="Linked\SupportContact.cs" />
  </ItemGroup>

</Project>
