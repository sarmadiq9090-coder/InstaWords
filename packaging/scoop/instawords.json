{
    "version": "2.1.0",
    "description": "InstaWords (تفقيط): amounts in words for cheques and invoices, in Arabic, English and French.",
    "homepage": "https://fastkiwi.app/instawords/",
    "license": "MIT",
    "notes": [
        "This is the portable build: InstaWords checks GitHub for new versions and opens the release page,",
        "but 'scoop update instawords' is the way to upgrade a Scoop install.",
        "Settings and history live in %APPDATA%\\FastKiwi\\InstaWords (not in the Scoop folder);",
        "delete that folder yourself to remove all data."
    ],
    "url": "https://github.com/sarmadiq9090-coder/tafket/releases/download/v2.1.0/InstaWords_2.1.0_x64-portable.zip",
    "hash": "b7ef87139f328a1dcb4e15c0463df8e23837fe10570635310d6e248b78cb43e0",
    "extract_dir": "InstaWords",
    "bin": "InstaWords.exe",
    "shortcuts": [
        [
            "InstaWords.exe",
            "InstaWords"
        ]
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    $run = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run'",
            "    $value = (Get-ItemProperty -Path $run -Name 'InstaWords' -ErrorAction SilentlyContinue).InstaWords",
            "    if ($value -and $value.ToLower().Contains((Split-Path $dir).ToLower())) {",
            "        Remove-ItemProperty -Path $run -Name 'InstaWords' -ErrorAction SilentlyContinue",
            "    }",
            "}"
        ]
    },
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/sarmadiq9090-coder/tafket/releases/download/v$version/InstaWords_$version_x64-portable.zip",
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
