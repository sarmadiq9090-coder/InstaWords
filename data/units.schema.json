{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sarmadiq9090-coder/tafket/blob/main/data/units.schema.json",
  "title": "Tafqit units catalog",
  "description": "Catalog of counted nouns (currencies, measures, counts). Every grammatical form is stored explicitly; the engine never derives forms. Optional `i18n` holds the forms in languages other than Arabic (docs/SPEC.md §17).",
  "type": "object",
  "required": [
    "schemaVersion",
    "units"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/unit"
      }
    }
  },
  "$defs": {
    "arabicText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
    },
    "gender": {
      "description": "m = masculine, f = feminine (of the singular noun).",
      "enum": [
        "m",
        "f"
      ]
    },
    "forms": {
      "type": "object",
      "required": [
        "singular",
        "dual",
        "plural",
        "accusative",
        "gender"
      ],
      "additionalProperties": false,
      "properties": {
        "singular": {
          "$ref": "#/$defs/arabicText",
          "description": "Singular (also used genitive after 100s/1000s and with 1): ريال سعودي"
        },
        "dual": {
          "$ref": "#/$defs/arabicText",
          "description": "Nominative dual used alone for 2: ريالان سعوديان"
        },
        "plural": {
          "$ref": "#/$defs/arabicText",
          "description": "Plural used with 3–10: ريالات سعودية"
        },
        "accusative": {
          "$ref": "#/$defs/arabicText",
          "description": "Indefinite accusative singular used with 11–99: ريالاً سعودياً"
        },
        "gender": {
          "$ref": "#/$defs/gender"
        },
        "one": {
          "$ref": "#/$defs/arabicText",
          "description": "Optional phrase used for exactly 1 instead of singular + واحد/واحدة (e.g. كيلومتر واحد في الساعة)."
        }
      }
    },
    "subunit": {
      "type": "object",
      "required": [
        "singular",
        "dual",
        "plural",
        "accusative",
        "gender",
        "ratio"
      ],
      "additionalProperties": false,
      "properties": {
        "singular": {
          "$ref": "#/$defs/arabicText"
        },
        "dual": {
          "$ref": "#/$defs/arabicText"
        },
        "plural": {
          "$ref": "#/$defs/arabicText"
        },
        "accusative": {
          "$ref": "#/$defs/arabicText"
        },
        "gender": {
          "$ref": "#/$defs/gender"
        },
        "ratio": {
          "description": "How many subunits make one unit. Must be a power of ten.",
          "type": "integer",
          "enum": [
            10,
            100,
            1000,
            10000,
            100000,
            1000000,
            10000000,
            100000000
          ]
        },
        "one": {
          "$ref": "#/$defs/arabicText",
          "description": "Optional phrase used for exactly 1 instead of singular + واحد/واحدة (e.g. كيلومتر واحد في الساعة)."
        },
        "i18n": {
          "$ref": "#/$defs/i18n"
        }
      }
    },
    "unit": {
      "type": "object",
      "required": [
        "id",
        "category",
        "label",
        "forms"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable identifier. Unique across the catalog (checked by the engine).",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "category": {
          "enum": [
            "currency-arab",
            "currency-world",
            "crypto",
            "generic-currency",
            "weight",
            "volume",
            "length",
            "area",
            "time",
            "count",
            "data",
            "speed",
            "none"
          ]
        },
        "label": {
          "$ref": "#/$defs/arabicText"
        },
        "code": {
          "description": "ISO 4217 code or crypto ticker, if any.",
          "type": "string",
          "pattern": "^[A-Z0-9]{2,10}$"
        },
        "aliases": {
          "description": "Alternative lookup names (Arabic or Latin). Unique across the catalog (checked by the engine).",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/arabicText"
          }
        },
        "forms": {
          "oneOf": [
            {
              "$ref": "#/$defs/forms"
            },
            {
              "type": "null"
            }
          ]
        },
        "i18n": {
          "$ref": "#/$defs/i18n",
          "description": "Forms of the unit in other languages (the subunit carries its own i18n)."
        },
        "subunit": {
          "$ref": "#/$defs/subunit"
        },
        "displayDigits": {
          "description": "Decimals an app shows for a whole amount of this money (no fraction, so the words name no subunit): 0 where the subunit is unused in everyday writing (IQD: 1,750,000, not 1,750,000.000). Absent: the subunit's digits (ratio 100 → 2). An amount with a fraction always shows every subunit digit (1,750,000.500). Display only: never affects the words or the rounding. Requires a subunit and must not exceed its digits (checked by the engine).",
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "note": {
          "description": "Reviewer note. Never affects output.",
          "type": "string"
        }
      },
      "dependentRequired": {
        "displayDigits": [
          "subunit"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "forms": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "none"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "subunit"
                  ]
                },
                {
                  "required": [
                    "i18n"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "forms": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "latinText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
    },
    "enForms": {
      "description": "English forms (Title Case).",
      "type": "object",
      "required": [
        "singular",
        "plural"
      ],
      "additionalProperties": false,
      "properties": {
        "singular": {
          "$ref": "#/$defs/latinText",
          "description": "Used with 1: Saudi Riyal"
        },
        "plural": {
          "$ref": "#/$defs/latinText",
          "description": "Used with every other number, including 0: Saudi Riyals"
        },
        "one": {
          "$ref": "#/$defs/latinText",
          "description": "Optional phrase for exactly 1 instead of \"One \" + singular."
        }
      }
    },
    "frForms": {
      "description": "French forms (lowercase, traditional orthography).",
      "type": "object",
      "required": [
        "singular",
        "plural",
        "gender"
      ],
      "additionalProperties": false,
      "properties": {
        "singular": {
          "$ref": "#/$defs/latinText",
          "description": "Used with 0 and 1: riyal saoudien"
        },
        "plural": {
          "$ref": "#/$defs/latinText",
          "description": "Used with 2 and more: riyals saoudiens"
        },
        "gender": {
          "$ref": "#/$defs/gender",
          "description": "Gender of the French noun (un/une, vingt et un/vingt et une)."
        },
        "one": {
          "$ref": "#/$defs/latinText",
          "description": "Optional phrase for exactly 1 instead of un/une + singular."
        }
      }
    },
    "i18n": {
      "description": "Forms in languages other than Arabic. A language missing here makes conversion to it fail with NO_LANGUAGE_FORMS.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": {
          "$ref": "#/$defs/enForms"
        },
        "fr": {
          "$ref": "#/$defs/frForms"
        }
      }
    }
  }
}
