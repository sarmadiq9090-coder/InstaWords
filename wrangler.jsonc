// Cloudflare Worker that serves _cf/tafqit/* at https://fastkiwi.app/tafqit/
// Build first: npm run build:cf   Deploy: npx wrangler@4.149.0 deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tafqit",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "fastkiwi.app/tafqit*", "zone_name": "fastkiwi.app" }
  ],
  "assets": {
    "directory": "./_cf",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
