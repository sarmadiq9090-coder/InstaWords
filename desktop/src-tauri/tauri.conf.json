{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "InstaWords",
  "mainBinaryName": "InstaWords",
  "version": "../../package.json",
  "identifier": "app.fastkiwi.instawords",
  "build": {
    "frontendDist": "../../_site",
    "beforeBuildCommand": { "script": "npm run build:site", "cwd": "../.." },
    "beforeDevCommand": { "script": "npm run build:site", "cwd": "../..", "wait": true }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "InstaWords — تفقيط المبالغ بالحروف",
        "width": 1200,
        "height": 860,
        "minWidth": 380,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "useHttpsScheme": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-hashes' 'sha256-GZIcz60Uwd6wT3vaYke/atSr53TehbYAPepOa3d03Vw='",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "'self' blob: ipc: http://ipc.localhost https://ipc.localhost",
        "manifest-src": "'self'",
        "worker-src": "'none'",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "FastKiwi",
    "copyright": "© FastKiwi — MIT License",
    "category": "Finance",
    "homepage": "https://fastkiwi.app/instawords/",
    "shortDescription": "InstaWords — تفقيط: numbers to words for cheques and invoices",
    "longDescription": "InstaWords (تفقيط) writes amounts in words — Arabic and other languages — for cheques, invoices and accounting documents. Works fully offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Arabic", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    }
  }
}
